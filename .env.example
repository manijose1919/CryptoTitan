# ============================================
# Crypto.com Exchange API
# ============================================
SESSION_API_KEY=your_crypto_com_api_key
SESSION_SECRET_KEY=your_crypto_com_secret_key

# ============================================
# Kraken Exchange API (alternative exchange)
# ============================================
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET=your_kraken_secret

# ============================================
# Exchange Selection
# ============================================
TRADING_EXCHANGE=kraken
V2_MODE=paper
# Required in addition to V2_MODE=live. Keep unset/no for paper trading.
V2_LIVE_CONFIRMED=no
V2_BUDGET=1000
PAIRS_MODE=off
PAIRS_LIVE_CONFIRMED=no
ADMIN_API_KEY=replace_with_a_long_random_secret
# Optional: isolate SQLite from data/trading.db (paper soaks / parallel instances)
# DATA_DIR=/tmp/cryptotitan-paper
# SQLITE_PATH=/tmp/cryptotitan-paper/trading.db
PORT=3033

# ============================================
# Anthropic Claude AI (trade analysis)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================
# Questrade (Canadian stock trading)
# ============================================
QUESTRADE_REFRESH_TOKEN=your_questrade_refresh_token

# ============================================
# TradingView Webhook Authentication
# ============================================
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# Telegram Notifications
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================
# VPS / CORS Configuration
# ============================================
VPS_IP=your_vps_ip_address

# Deployment target host (IP or DNS name). Required by monitor.sh,
# scripts/push-deploy.sh, and deploy/deploy.ps1 — they exit immediately if it
# is unset. Deliberately not committed; keep the real value in .env.local.
VPS_HOST=
CORS_ORIGIN=http://localhost:3000

# ============================================
# Data Services (optional)
# ============================================
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
YOUTUBE_API_KEY=your_youtube_api_key
