{
  "name": "cryptotitan",
  "version": "1.0.0",
  "description": "Canadian-universe paper-first crypto daytrading engine — Kraken USD pairs, dual live interlock, React monitor",
  "main": "serverV2.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types serverV2.ts",
    "dev": "concurrently \"node --experimental-strip-types serverV2.ts\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@tanstack/react-query": "^5.90.21",
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.378.0",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7",
    "ws": "^8.21.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "eslint": "^10.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
